# Better Auth (cookie sessions on D1). Required in the Worker.
BETTER_AUTH_SECRET=
# Public origin. The Worker also sets this in wrangler.jsonc.
BETTER_AUTH_URL=https://cuentix.lulox.com.ar
AUTH_URL=https://cuentix.lulox.com.ar

# Google OAuth. Redirect URI: https://cuentix.lulox.com.ar/api/auth/callback/google
# If either value is unset, the login page says Google is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: emails extra (además del admin fijo), separados por coma
ALLOWED_EMAILS=

# Polar (billing / suscripción Pro)
# Creá org + producto recurrente en https://polar.sh (sandbox o production)
# Producto: Pro, mensual, 9.990 ARS (Polar lista ARS como moneda de producto).
# Si tu org no puede cobrar en ARS, usá ~USD 7 y el checkout cae al precio del catálogo.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# sandbox | production
POLAR_SERVER=sandbox
# URL pública de la app (success/return del checkout). En Vercel se puede omitir.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook a registrar en Polar:
#   POST ${NEXT_PUBLIC_APP_URL}/api/billing/webhook
# Eventos: subscription.created, subscription.updated, subscription.canceled

# OpenAI (OCR tickets + PDF resumen genérico)
OPENAI_API_KEY=

# Agent HTTP API — docs/agent-api.md
AGENT_API_TOKEN=
AGENT_USER_ID=
AGENT_USER_EMAIL=

# Deuda (Casita card + /deuda). On by default after the open-cuotas rebuild.
# NEXT_PUBLIC_DEUDA_ENABLED=0

# Roommate payee tokens. Worker runtime variable only. Example: ANA+PEREZ,ANITA
REINTEGRO_PAYEES=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare / opennext
.dev.vars
.open-next
.wrangler
.d1-import
dist/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# secrets, local data (never commit)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
backups/
*.sql.bak
*-backup*.sql
uploads/
statements/
*.log
